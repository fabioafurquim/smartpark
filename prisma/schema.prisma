generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoLocacao {
  HORA
  DIARIA
  MENSAL
  ANUAL
}

enum StatusPagamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
  REEMBOLSADO
}

model ConfiguracaoSistema {
  id                             String   @id @default(cuid())
  administradorMestreConfigurado Boolean  @default(false)
  criadoEm                       DateTime @default(now())
  atualizadoEm                   DateTime @updatedAt

  @@map("configuracao_sistema")
}

model Usuario {
  id                   String                @id @default(cuid())
  nome                 String
  email                String                @unique
  senha                String?
  ativo                Boolean               @default(true)
  criadoEm             DateTime              @default(now())
  atualizadoEm         DateTime              @updatedAt
  accounts             Account[]
  perfis               PerfilUsuario[]
  reservas             Reserva[]             @relation("ReservasUsuario")
  sessions             Session[]
  solicitacoesCadastro SolicitacaoCadastro[]
  vagasProprietario    Vaga[]                @relation("ProprietarioVaga")
  unidades             Unidade[]             @relation("UnidadeUsuario")
  locacoesLocatario    Locacao[]             @relation("LocatarioLocacoes")
  locacoesProprietario Locacao[]             @relation("ProprietarioLocacoes")
  notificacoes         Notificacao[]

  @@map("usuarios")
}

model Condominio {
  id                   String                @id @default(cuid())
  nome                 String
  endereco             String
  telefone             String?
  email                String?
  codigoUnico          String                @unique
  logoUrl              String?
  ativo                Boolean               @default(true)
  criadoEm             DateTime              @default(now())
  atualizadoEm         DateTime              @updatedAt
  perfisUsuario        PerfilUsuario[]
  reservas             Reserva[]
  solicitacoesCadastro SolicitacaoCadastro[]
  torres               Torre[]
  unidades             Unidade[]
  vagas                Vaga[]

  @@map("condominios")
}

model Torre {
  id           String     @id @default(cuid())
  nome         String
  descricao    String?
  condominioId String
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  tipo         String     @default("TORRE")
  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  unidades     Unidade[]

  @@map("torres")
}

model Unidade {
  id                   String                @id @default(cuid())
  numero               String
  torreId              String
  criadoEm             DateTime              @default(now())
  atualizadoEm         DateTime              @updatedAt
  condominioId         String
  contato              String?
  proprietario         String?
  tipo                 String                @default("APARTAMENTO")
  andar                Int                   @default(0)
  usuarioId            String?
  solicitacoesCadastro SolicitacaoCadastro[]
  condominio           Condominio            @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  torre                Torre                 @relation(fields: [torreId], references: [id], onDelete: Cascade)
  usuario              Usuario?              @relation("UnidadeUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  vagas                Vaga[]

  @@map("unidades")
}

model Vaga {
  id                   String                @id @default(cuid())
  numero               String
  tipo                 String                @default("COBERTA")
  unidadeId            String
  proprietarioId       String?
  criadoEm             DateTime              @default(now())
  atualizadoEm         DateTime              @updatedAt
  condominioId         String
  reservas             Reserva[]
  solicitacoesCadastro SolicitacaoCadastro[]
  locacoes             Locacao[]
  condominio           Condominio            @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  proprietario         Usuario?              @relation("ProprietarioVaga", fields: [proprietarioId], references: [id])
  unidade              Unidade               @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  configuracaoLocacao  ConfiguracaoLocacaoVaga?

  @@map("vagas")
}

model ConfiguracaoLocacaoVaga {
  id             String       @id @default(cuid())
  vagaId         String       @unique
  disponivel     Boolean      @default(false)
  tiposPermitidos TipoLocacao[]
  valorHora      Decimal?     @db.Decimal(10, 2)
  valorDiaria    Decimal?     @db.Decimal(10, 2)
  valorMensal    Decimal?     @db.Decimal(10, 2)
  valorAnual     Decimal?     @db.Decimal(10, 2)
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt
  vaga           Vaga         @relation(fields: [vagaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_locacao_vaga")
}

model Reserva {
  id              String           @id @default(cuid())
  vagaId          String
  usuarioId       String
  condominioId    String
  dataInicio      DateTime
  dataFim         DateTime
  status          String           @default("ativa")
  statusPagamento StatusPagamento  @default(PENDENTE)
  observacoes     String?
  criadoEm        DateTime         @default(now())
  atualizadoEm    DateTime         @updatedAt
  tipoLocacao     TipoLocacao?
  valor           Decimal?         @db.Decimal(10, 2)
  condominio      Condominio       @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  usuario         Usuario          @relation("ReservasUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  vaga            Vaga             @relation(fields: [vagaId], references: [id], onDelete: Cascade)

  @@map("reservas")
}

model PerfilUsuario {
  id           String     @id @default(cuid())
  usuarioId    String
  condominioId String
  tipo         String
  permissoes   Json?
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  usuario      Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, condominioId, tipo])
  @@map("perfis_usuario")
}

model SolicitacaoCadastro {
  id           String     @id @default(cuid())
  usuarioId    String
  condominioId String
  unidadeId    String?
  vagaId       String?
  status       String     @default("pendente")
  observacoes  String?
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  unidade      Unidade?   @relation(fields: [unidadeId], references: [id])
  usuario      Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  vaga         Vaga?      @relation(fields: [vagaId], references: [id])

  @@map("solicitacoes_cadastro")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Locacao {
  id             String   @id @default(cuid())
  vagaId         String
  vaga           Vaga     @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  
  locatarioId    String
  locatario      Usuario  @relation("LocatarioLocacoes", fields: [locatarioId], references: [id], onDelete: Cascade)
  
  proprietarioId String
  proprietario   Usuario  @relation("ProprietarioLocacoes", fields: [proprietarioId], references: [id], onDelete: Cascade)
  
  dataInicio     DateTime
  dataFim        DateTime
  tipoLocacao    String
  valor          Float
  status         String   @default("PENDENTE")
  
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt
  
  @@map("locacoes")
}

model Notificacao {
  id           String   @id @default(cuid())
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  tipo         String   // LOCACAO_SOLICITADA, LOCACAO_APROVADA, LOCACAO_REJEITADA, LOCACAO_CANCELADA, SISTEMA
  titulo       String
  mensagem     String
  lida         Boolean  @default(false)
  
  // Referências opcionais para navegação
  locacaoId    String?
  
  criadoEm     DateTime @default(now())
  
  @@map("notificacoes")
}
